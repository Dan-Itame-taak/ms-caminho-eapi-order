        <logger level="INFO" doc:name="End - Logger" doc:id="aa1a18d4-53ce-4b55-82d0-4a6086efab03" message="#[%dw 2.0&#xA;output application/json&#xA;---&#xA;{&#xA; message: &quot;End Flow Send Backup Car to Dealernet&quot;,&#xA; payload: payload,&#xA; attributes: attributes,&#xA; correlationId: correlationId&#xA; &#xA;}]" />
    </flow>
    <flow name="put:\proposal\(id):application\json:order-eapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" message="put:\proposal\(id):application\json:order-eapi-config" />
    </flow>
    <flow name="delete:\proposal\(id):order-eapi-config">
        <logger level="INFO" doc:name="Start - Logger" doc:id="6bb2911a-025b-4576-b4cc-2b1768224807" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10; message: "Start Flow Send Proposal Status Cancel to Dealernet",&#10; payload: payload,&#10; attributes: attributes,&#10; correlationId: correlationId&#10; &#10;}]' />
		<ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
		<flow-ref doc:name="cancel-proposal-subflow" doc:id="0b4cbc55-1307-4be0-aad5-ce28533b187c" name="cancel-proposal-subflow"/>
		<logger level="INFO" doc:name="End - Logger" doc:id="60292e2d-e80e-4975-a1b4-b2bc649a0a2e" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10; message: "End Flow Send Proposal Status Cancel to Dealernet",&#10; payload: payload,&#10; attributes: attributes,&#10; correlationId: correlationId&#10; &#10;}]' />
