    <flow name="post:\backup-car:application\json:order-eapi-config">
        <logger level="INFO" doc:name="Start - Logger" doc:id="d922d401-5719-46ae-91ac-bdc7d29b8418" message="#[%dw 2.0&#xA;output application/json&#xA;---&#xA;{&#xA; message: &quot;Start Flow Send Backup Cara to Dealernet&quot;,&#xA; payload: payload,&#xA; attributes: attributes,&#xA; correlationId: correlationId&#xA; &#xA;}]" />
