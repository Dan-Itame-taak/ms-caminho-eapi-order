        <flow-ref doc:name="send-service-appointment-subflow" doc:id="3332c16b-f840-4bb5-99cc-cdb42ef6aba6" name="send-service-appointment-subflow" />
        <logger level="INFO" doc:name="End - Logger" doc:id="4653d28c-8c45-45e5-bbcd-b34413e554e0" message="#[%dw 2.0&#xA;output application/json&#xA;---&#xA;{&#xA; message: &quot;End Flow Send Appointment to Dealernet&quot;,&#xA; payload: payload,&#xA; attributes: attributes,&#xA; correlationId: correlationId&#xA; &#xA;}]" />
