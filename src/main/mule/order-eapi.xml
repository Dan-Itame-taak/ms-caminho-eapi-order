        <flow-ref doc:name="send-service-order-subflow" doc:id="47853088-ce43-4e5d-9c39-22857d0e067c" name="send-service-order-subflow" />
        <logger level="INFO" doc:name="End - Logger" doc:id="ea7bf438-f3ce-4c62-a77e-217c91cf8d94" message="#[%dw 2.0&#xA;output application/json&#xA;---&#xA;{&#xA; message: &quot;End Flow Send Work Order to Dealernet&quot;,&#xA; payload: payload,&#xA; attributes: attributes,&#xA; correlationId: correlationId&#xA; &#xA;}]" />
    </flow>
    <flow name="post:\used-valuation:application\json:order-eapi-config">
        <logger level="INFO" doc:name="Start - Logger" doc:id="34dcfb84-e7a3-402b-aa16-0ff922809642" message="#[%dw 2.0&#xA;output application/json&#xA;---&#xA;{&#xA; message: &quot;Start Flow Send Used Evaluation to Dealernet&quot;,&#xA; payload: payload,&#xA; attributes: attributes,&#xA; correlationId: correlationId&#xA; &#xA;}]" />
        <flow-ref doc:name="send-used-evaluation-subflow" doc:id="3d451b76-4df6-4118-8044-c127abb6e3d5" name="send-used-evaluation-subflow" />
        <logger level="INFO" doc:name="End - Logger" doc:id="0dd47cee-2579-4052-87e1-5f067113fd46" message="#[%dw 2.0&#xA;output application/json&#xA;---&#xA;{&#xA; message: &quot;End Flow Send Used Evaluation to Dealernet&quot;,&#xA; payload: payload,&#xA; attributes: attributes,&#xA; correlationId: correlationId&#xA; &#xA;}]" />
    </flow>
    <flow name="post:\simulation\(token):application\json:order-eapi-config">
        <choice doc:name="Choice" doc:id="a238e530-f007-4515-bc7e-a65d97c9e01a">
            <when expression="#[attributes.uriParams.token == p('secure::fandi.token')]">
                <ee:transform doc:name="Payload" doc:id="658a60fb-8d7e-4570-864f-709bd9303918">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
                <flow-ref doc:name="send-financing-simulation-to-salesforce-sapi" doc:id="d0e90063-09e6-4f5a-9035-9565b8f14628" name="send-financing-simulation-to-salesforce-sapi" />
            </when>
            <otherwise>
                <raise-error doc:name="Raise error" doc:id="741f1f18-0dac-4240-b5fb-f32200db53af" type="ORDER-EAPI:UNAUTHORIZED" description="Token inválido." />
            </otherwise>
        </choice>
        <error-handler ref="globalError_Router" />
    </flow>
    <flow name="get:\employees\scheduled:order-eapi-config">
        <ee:transform doc:name="Variables to Get Mechanics Scheduliing and recordType" doc:id="cffee14d-f3ae-49af-8907-975f307e814d">
            <ee:message />
            <ee:variables>
                <ee:set-variable variableName="department"><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.department]]></ee:set-variable>
                <ee:set-variable variableName="object"><![CDATA[%dw 2.0
output application/json
---
"Seller__c"]]></ee:set-variable>
                <ee:set-variable variableName="name"><![CDATA[%dw 2.0
output application/json
---
if(attributes.queryParams.department == "mechanic")"Produtivo"
else "Consultor"]]></ee:set-variable>
                <ee:set-variable variableName="company"><![CDATA[%dw 2.0
output application/json
---
attributes.queryParams.company]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref doc:name="search-recordType-salesforce" doc:id="f3212875-c097-496b-bea4-56911fcecb0d" name="search-recordType-salesforce" />
        <flow-ref doc:name="get-employees-schedulling" doc:id="193280ac-c9e5-4620-bfa9-66dfacc99b4b" name="get-employees-schedulling" />
        <error-handler ref="globalError_Router" />
    </flow>
    <flow name="post:\fandi\credit-analysis\status:application\json:order-eapi-config">
        <ee:transform doc:name="Payload" doc:id="421b090e-ea91-4c98-9ff0-755b83661cbf">
